// ─────────────────────────────────────────────────────────────────────────────
// Prisma Schema – Civil Work Monitor
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  SUPERVISOR
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  RENOVATION
}

enum WorkerCategory {
  MASONS
  HELPERS
  ELECTRICIANS
  PLUMBERS
  CARPENTERS
  PAINTERS
  STEEL_WORKERS
  OTHER
}

enum MaterialName {
  CEMENT
  SAND
  STEEL_RODS
  BRICKS
  BLUE_METAL
  M_SAND
  WOOD
  ELECTRICAL_MATERIALS
  PLUMBING_MATERIALS
}

enum MaterialUnit {
  BAGS
  TONS
  KG
  NUMBERS
  CUBIC_FEET
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
}

enum OtpStatus {
  PENDING
  VERIFIED
  EXPIRED
}

// ─────────────────────────────────────────────────────────────────────────────
// OTP – temporary verification codes sent to phone numbers
// ─────────────────────────────────────────────────────────────────────────────

model Otp {
  id        String    @id @default(cuid())
  phone     String
  role      Role
  code      String
  status    OtpStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([phone, role])
}

// ─────────────────────────────────────────────────────────────────────────────
// Owner – primary stakeholder who owns and monitors the project
// ─────────────────────────────────────────────────────────────────────────────

model Owner {
  id          String   @id @default(cuid())
  phone       String   @unique
  fullName    String
  email       String?
  companyName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects Project[]

  @@index([phone])
}

// ─────────────────────────────────────────────────────────────────────────────
// Project – construction project linked to an owner
// ─────────────────────────────────────────────────────────────────────────────

model Project {
  id             String      @id @default(cuid())
  name           String
  type           ProjectType
  siteAddress    String
  latitude       Float?
  longitude      Float?
  budget         Float?
  numberOfFloors Int?
  progress       Float       @default(0) // percentage 0–100
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  ownerId String
  owner   Owner  @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  supervisors  Supervisor[]
  dailyUpdates DailyUpdate[]

  @@index([ownerId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Supervisor – site supervisor assigned to a project
// ─────────────────────────────────────────────────────────────────────────────

model Supervisor {
  id           String   @id @default(cuid())
  supervisorId String   @unique // e.g. SUP-123456
  name         String
  phone        String   @unique
  email        String   @unique
  location     String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  dailyUpdates DailyUpdate[]

  @@index([phone])
  @@index([projectId])
}

// ─────────────────────────────────────────────────────────────────────────────
// DailyUpdate – single combined daily report submitted by a supervisor
// ─────────────────────────────────────────────────────────────────────────────

model DailyUpdate {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supervisorId String
  supervisor   Supervisor @relation(fields: [supervisorId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  workerEntries    WorkerEntry[]
  materialRequests MaterialRequest[]

  @@index([supervisorId])
  @@index([projectId])
  @@index([date])
}

// ─────────────────────────────────────────────────────────────────────────────
// WorkerEntry – daily worker headcount + wage for a category
// ─────────────────────────────────────────────────────────────────────────────

model WorkerEntry {
  id          String         @id @default(cuid())
  category    WorkerCategory
  headcount   Int
  dailyWage   Float
  totalSalary Float
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  dailyUpdateId String
  dailyUpdate   DailyUpdate @relation(fields: [dailyUpdateId], references: [id], onDelete: Cascade)

  @@index([dailyUpdateId])
}

// ─────────────────────────────────────────────────────────────────────────────
// MaterialRequest – material quantity requested on a given day
// ─────────────────────────────────────────────────────────────────────────────

model MaterialRequest {
  id             String       @id @default(cuid())
  material       MaterialName
  quantity       Float
  unit           MaterialUnit
  urgencyLevel   UrgencyLevel @default(MEDIUM)
  requiredByDate DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  dailyUpdateId String
  dailyUpdate   DailyUpdate @relation(fields: [dailyUpdateId], references: [id], onDelete: Cascade)

  @@index([dailyUpdateId])
}
